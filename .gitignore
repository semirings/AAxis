# --------------------
# Blender
# --------------------
*.blend1
*.blend2
*.blend3
*.blend@
*.blend.tmp

# Generated Blender outputs
/blender/out/
/renders/
*.blend

# --------------------
# Media outputs
# --------------------
*.png
*.jpg
*.jpeg
*.exr
*.mp4
*.mov
*.wav
*.aiff
*.aif
*.mp3

# --------------------
# Python / Jupyter
# --------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --------------------
# Allow hand-authored assets
# --------------------
!assets/**/*.blend
!templates/**/*.blend
!audio/src/**/*.wav
